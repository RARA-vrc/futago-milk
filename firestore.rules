rules_version = '2';

// ふたごミルク帳のアクセスルール。
// Firebase コンソール → Firestore Database →「ルール」タブに全文を貼り付けて「公開」してください。
// 下の2つのメールアドレスを、あなたと奥さんの Google アカウントに書き換えます。
// （メールアドレスは公開リポジトリには入れず、コンソール上だけで書き換えるのがおすすめです）

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'YOUR_EMAIL@gmail.com',
          'PARTNER_EMAIL@gmail.com'
        ];
    }

    // 授乳・おしっこ・うんち・体重の記録
    match /logs/{logId} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.baby in ['ane', 'imouto']
        && request.resource.data.type in ['milk', 'pee', 'poo', 'weight', 'measure', 'temp']
        && request.resource.data.at is number;
    }

    // 呼び名・授乳間隔・量の目安
    match /babies/{babyId} {
      allow read: if isFamily();
      allow write: if isFamily() && babyId in ['ane', 'imouto'];
    }

    // ノート：今日のメモ（姉・妹・ママ・パパ）
    match /memos/{memoId} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.who in ['ane', 'imouto', 'mama', 'papa']
        && request.resource.data.day is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.at is number;
    }

    // ノート：メモの写真（圧縮した JPEG を1枚1ドキュメントで保存。写真は書き換えない）
    match /memoPhotos/{photoId} {
      allow read, delete: if isFamily();
      allow create: if isFamily()
        && request.resource.data.memoId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
    }

    // ノート：費用（買ったもの・買うものリスト）
    match /expenses/{expenseId} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.status in ['bought', 'want']
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.qty is number
        && request.resource.data.at is number;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
